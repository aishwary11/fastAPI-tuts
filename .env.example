# Copy to `.env` and fill in your own values.
APP_NAME=Library API
ENVIRONMENT=development
DEBUG=false

# --- Database ---------------------------------------------------------------
# Either set the individual POSTGRES_* parts below, or set DATABASE_URL to a
# full SQLAlchemy URL, e.g. postgresql+asyncpg://user:pass@host:5432/library
# DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=library

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Middleware -------------------------------------------------------------
# Comma-separated list of origins, or * for any.
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a reverse proxy you control (makes the limiter trust
# the client-supplied X-Forwarded-For header).
TRUST_PROXY_HEADERS=false

# --- Library business rules -------------------------------------------------
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS_PER_MEMBER=5
